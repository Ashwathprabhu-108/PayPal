# ============================================================
# PayGuard AI — Backend Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./payguard.db

# ── LLM Provider ─────────────────────────────────────────────
# Options: "gemini" | "openai" | "anthropic" | "none" (rule-engine only)
LLM_PROVIDER=gemini

# Google Gemini (free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── PayPal Sandbox ───────────────────────────────────────────
# Create credentials at https://developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── Currency Conversion ──────────────────────────────────────
# Fixed demo conversion rate for Sandbox testing (INR → USD)
# PayPal Sandbox does not support INR natively.
INR_TO_USD_DEMO_RATE=84.0

# ── Risk Engine ──────────────────────────────────────────────
# Override default weights if needed (optional)
# RISK_WEIGHT_URGENCY=20
# RISK_WEIGHT_PRESSURE=15
# RISK_WEIGHT_HIDE_PURPOSE=25
